POSTEO_USERNAME=you@posteo.de
# On macOS, omit POSTEO_PASSWORD to read service "posteo-mcp" from Keychain.
# POSTEO_PASSWORD=your-dedicated-posteo-mcp-app-password
# POSTEO_MODE=read-only
# Optional overrides:
# POSTEO_TRASH_FOLDER=Trash
# POSTEO_DRAFTS_FOLDER=Drafts
# POSTEO_MAX_MESSAGE_BYTES=1048576
# POSTEO_MAX_BODY_CHARS=100000
# POSTEO_MAX_REQUEST_BYTES=65536
# POSTEO_NETWORK_TIMEOUT_MS=15000
# POSTEO_MAX_OPS_PER_MINUTE=30
# POSTEO_KEYCHAIN_SERVICE=posteo-mcp
