{
  "name": "posteo-mcp",
  "version": "0.1.0",
  "description": "Zero-dependency, local MCP server for Posteo mail",
  "type": "module",
  "private": true,
  "bin": {
    "posteo-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "test:integration": "POSTEO_INTEGRATION=1 node --test test/integration.test.js",
    "check": "node --check src/index.js && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
