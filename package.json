  "keywords": [
    "mcp",
    "model-context-protocol",
    "posteo",
    "email",
    "imap",
    "ai-agents",
    "privacy",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustworthy-tech/posteo-mcp.git"
  },
  "homepage": "https://github.com/trustworthy-tech/posteo-mcp#readme",
